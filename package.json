{
  "name": "fillio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "type": "module",
  "description": "Local-first career form autofill browser extension",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "wxt",
    "prepare": "wxt prepare",
    "postinstall": "wxt prepare",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "node e2e/extension-smoke.mjs && node e2e/iteration3-acceptance.mjs && node e2e/iteration4-vault.mjs && node e2e/iteration6-design-polish.mjs && node e2e/iteration14-workspace-cv.mjs",
    "verify:manifest": "node scripts/verify-manifest.mjs",
    "verify:compatibility": "node scripts/verify-compatibility-evidence.mjs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "lucide-react": "1.34.0",
    "mammoth": "1.12.1",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@wxt-dev/module-react": "1.2.2",
    "eslint": "9.39.5",
    "jsdom": "30.0.1",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "wxt": "0.21.1"
  }
}
